rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isSeller() {
      return signed()
        && exists(/databases/$(db)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(db)/documents/sellers/$(request.auth.uid)).data.st == 'active'
        && get(/databases/$(db)/documents/sellers/$(request.auth.uid)).data.setup == true;
    }
    function activeSeller(uid) {
      return exists(/databases/$(db)/documents/sellers/$(uid))
        && get(/databases/$(db)/documents/sellers/$(uid)).data.st == 'active';
    }

    // Daftar admin: hanya akun admin@only4u.app yang boleh mendaftarkan dirinya sendiri (sekali, lewat setup-admin.html)
    match /admins/{id} {
      allow read: if signed() && request.auth.uid == id;
      allow create: if signed() && request.auth.uid == id
        && request.auth.token.email == 'admin@only4u.app'
        && request.resource.data.keys().hasOnly(['role']);
      allow update, delete: if false;
    }

    // Profil akun pelanggan
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'ref'])
        && (!('ref' in request.resource.data)
            || (exists(/databases/$(db)/documents/refs/$(request.resource.data.ref))
                && get(/databases/$(db)/documents/refs/$(request.resource.data.ref)).data.u != request.auth.uid));
      allow update: if false;
      allow delete: if isAdmin();   // admin boleh membersihkan akun yang sudah tidak ada
    }

    // Order (pembeli, admin, dan penjual toko terkait)
    match /orders/{oid} {
      allow read: if signed() && (resource.data.u == request.auth.uid || isAdmin() || resource.data.sid == request.auth.uid);

      allow create: if signed()
        && request.resource.data.u == request.auth.uid
        && request.resource.data.id == oid
        && request.resource.data.st == 'p'
        && request.resource.data.total is number
        && request.resource.data.keys().hasOnly(['u','un','id','k','item','acc','total','t','exp','st','q','fid','pid','bd','sid','sn','gn'])
        && request.resource.data.get('q', 1) is number && request.resource.data.get('bd', '').size() <= 400
        && request.resource.data.get('sn', '').size() <= 40
        && request.resource.data.get('gn', '').size() <= 60
        && (request.resource.data.get('sid', '') == '' || activeSeller(request.resource.data.sid));

      allow update: if isAdmin()
        || (signed() && resource.data.u == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','paid','rx'])
          && request.resource.data.get('rx', '') in ['', 'up', 'love']
          && (request.resource.data.st == resource.data.st
              || (resource.data.st == 'p' && request.resource.data.st in ['e','c'])
              || (resource.data.st == 'p' && request.resource.data.st == 'v'
                  && existsAfter(/databases/$(db)/documents/proofs/$(oid)))))
        // Penjual: setujui/tolak order tokonya sendiri, kirim pesan/link ke pembeli
        || (signed() && resource.data.get('sid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','msg','ps','sd'])
          && (request.resource.data.st == resource.data.st
              || (request.resource.data.st in ['d','e'] && resource.data.st in ['p','v'])));

      allow delete: if false;
    }

    // Live chat (admin atau penjual tertentu lewat field "to")
    match /chats/{cid} {
      allow read: if signed() && (resource.data.u == request.auth.uid || isAdmin() || resource.data.to == request.auth.uid);
      allow create: if signed() && request.resource.data.u == request.auth.uid
        && request.resource.data.st == 'open'
        && request.resource.data.keys().hasOnly(['u','un','st','t','at','ls','to'])
        && (!('to' in request.resource.data) || activeSeller(request.resource.data.to));
      allow update: if isAdmin()
        || (signed() && resource.data.u == request.auth.uid && resource.data.st == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at','ls'])
            && request.resource.data.ls == 'u')
        // Penutupan otomatis oleh pemilik chat: hanya jika admin/bot terakhir yang menulis dan sudah lewat 5 menit
        || (signed() && resource.data.u == request.auth.uid && resource.data.st == 'open'
            && resource.data.ls != 'u'
            && request.time.toMillis() - resource.data.at >= 300000
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','at','ls','cr'])
            && request.resource.data.st == 'closed' && request.resource.data.cr == 'timeout')
        // Penjual membalas / menutup chat tokonya
        || (signed() && resource.data.get('to', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at','ls','st','cr']));
      allow delete: if false;

      match /msgs/{mid} {
        allow read: if signed() && (get(/databases/$(db)/documents/chats/$(cid)).data.u == request.auth.uid
          || isAdmin()
          || get(/databases/$(db)/documents/chats/$(cid)).data.get('to', '') == request.auth.uid);
        allow create: if signed()
          && request.resource.data.keys().hasOnly(['s','x','t'])
          && request.resource.data.x is string
          && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 500
          && ((isAdmin() && request.resource.data.s in ['a','b'])
              || (request.resource.data.s == 'a'
                  && get(/databases/$(db)/documents/chats/$(cid)).data.get('to', '') == request.auth.uid)
              || (request.resource.data.s == 'u'
                  && get(/databases/$(db)/documents/chats/$(cid)).data.u == request.auth.uid
                  && get(/databases/$(db)/documents/chats/$(cid)).data.st == 'open')
              // Pesan sambutan otomatis: hanya satu per chat (id "greet"), teksnya harus persis seperti ini
              || (request.resource.data.s == 'b' && mid == 'greet'
                  && getAfter(/databases/$(db)/documents/chats/$(cid)).data.u == request.auth.uid
                  && request.resource.data.x == 'Halo kak ' + getAfter(/databases/$(db)/documents/chats/$(cid)).data.un + ', selamat datang di live chat bantuan, ada yang bisa kami bantu?')
              || (request.resource.data.s == 'b' && mid == 'timeout'
                  && get(/databases/$(db)/documents/chats/$(cid)).data.u == request.auth.uid
                  && get(/databases/$(db)/documents/chats/$(cid)).data.st == 'open'
                  && get(/databases/$(db)/documents/chats/$(cid)).data.ls != 'u'
                  && request.time.toMillis() - get(/databases/$(db)/documents/chats/$(cid)).data.at >= 300000
                  && request.resource.data.x == 'Percakapan ditutup otomatis karena tidak ada respons selama 5 menit. Silakan mulai live chat baru jika masih butuh bantuan.'));
        allow update, delete: if false;
      }
    }

    // Antrian live chat (hanya waktu, uid, dan tujuan, untuk menghitung posisi)
    match /queue/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u','t','to']);
      allow update: if false;
      allow delete: if isAdmin() || (signed() && (resource.data.u == request.auth.uid || resource.data.get('to', '') == request.auth.uid));
    }

    // Kode referral: satu kode per pemain, bisa dibaca semua pengguna login untuk validasi
    match /refs/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u','t'])
        && code.matches('[A-Z0-9]{8}');
      allow update, delete: if false;

      // Daftar pemain yang bergabung lewat kode ini (dicatat saat daftar, bersama dokumen akun)
      match /joins/{uid} {
        allow read: if signed() && (get(/databases/$(db)/documents/refs/$(code)).data.u == request.auth.uid || isAdmin());
        allow create: if signed() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['un','t'])
          && getAfter(/databases/$(db)/documents/users/$(uid)).data.ref == code
          && request.resource.data.un == getAfter(/databases/$(db)/documents/users/$(uid)).data.username;
        allow update, delete: if false;
      }
    }

    // Produk tambahan: admin (bebas) dan penjual aktif (hanya produk tokonya sendiri)
    match /products/{pid} {
      allow read: if signed();
      allow create: if (isAdmin() && validProduct())
        || (isSeller() && validProduct() && request.resource.data.get('sid', '') == request.auth.uid);
      allow update: if (isAdmin() && validProduct())
        || (signed() && resource.data.get('sid', '') == request.auth.uid
            && request.resource.data.get('sid', '') == request.auth.uid && validProduct());
      allow delete: if isAdmin() || (signed() && resource.data.get('sid', '') == request.auth.uid);
    }
    function validProduct() {
      return request.resource.data.keys().hasOnly(['k','n','p','c','i','t','o','s','off','sid','sn'])
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 60
        && request.resource.data.p is number && request.resource.data.p > 0
        && request.resource.data.get('o', 0) is number && request.resource.data.get('o', 0) >= 0
        && request.resource.data.get('s', -1) is number
        && request.resource.data.get('i', '').size() <= 400000
        && request.resource.data.get('sn', '').size() <= 40;
    }

    // Pengajuan jadi penjual: dikirim pembeli, ditinjau admin
    match /sellerReq/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.u == uid && request.resource.data.st == 'pending'
        && request.resource.data.keys().hasOnly(['u','un','wa','tt','pr','st','t'])
        && request.resource.data.pr is list && request.resource.data.pr.size() >= 1 && request.resource.data.pr.size() <= 3
        && request.resource.data.wa is string && request.resource.data.wa.size() <= 16
        && request.resource.data.tt is string && request.resource.data.tt.size() <= 30;
      allow update: if isAdmin()
        || (signed() && request.auth.uid == uid && resource.data.st == 'rejected'
            && request.resource.data.u == uid && request.resource.data.st == 'pending'
            && request.resource.data.keys().hasOnly(['u','un','wa','tt','pr','st','t'])
            && request.resource.data.pr is list && request.resource.data.pr.size() >= 1 && request.resource.data.pr.size() <= 3);
      allow delete: if false;
    }

    // Akun penjual: dibuat admin saat menyetujui; penjual mengatur profil tokonya sendiri
    match /sellers/{uid} {
      allow read: if signed();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['u','un','st','shop','slug','logo','ban','qr','wa','desc','setup','t']);
      allow update: if isAdmin()
        || (signed() && request.auth.uid == uid && resource.data.st == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shop','slug','logo','ban','qr','wa','desc','setup','soc','rl','jam'])
            && request.resource.data.shop is string && request.resource.data.shop.size() <= 40
            && (request.resource.data.slug == resource.data.slug || resource.data.slug == '')
            && request.resource.data.get('logo', '').size() <= 400000
            && request.resource.data.get('ban', '').size() <= 400000
            && request.resource.data.get('qr', '').size() <= 400000
            && request.resource.data.get('wa', '').size() <= 20
            && request.resource.data.get('desc', '').size() <= 300
            && request.resource.data.get('rl', '').size() <= 600
            && request.resource.data.get('jam', '').size() <= 40
            && request.resource.data.get('soc', []).size() <= 5);
      allow delete: if isAdmin();
    }

    // Alamat unik toko (/toko/<slug>): diklaim sekali saat setting toko
    match /slugs/{slug} {
      allow read: if signed();
      allow create: if signed() && slug.matches('[a-z0-9]{3,30}')
        && request.resource.data.keys().hasOnly(['u']) && request.resource.data.u == request.auth.uid
        && exists(/databases/$(db)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(db)/documents/sellers/$(request.auth.uid)).data.st == 'active'
        && getAfter(/databases/$(db)/documents/sellers/$(request.auth.uid)).data.slug == slug;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Gambar profil & banner game, diatur admin dari panel
    match /gimg/{k} {
      allow read: if signed();
      allow write: if (isAdmin() || ownGame(k))
        && request.resource.data.keys().hasOnly(['p','b'])
        && request.resource.data.p is string && request.resource.data.b is string
        && request.resource.data.p.size() <= 400000 && request.resource.data.b.size() <= 400000;
    }

    // Flash sale yang diatur admin (waktu, produk, harga, stok)
    match /flash/{fid} {
      allow read: if signed();
      allow create: if (isAdmin() && validFlash())
        || (isSeller() && validFlash() && request.resource.data.get('sid', '') == request.auth.uid);
      allow update: if (isAdmin() && validFlash())
        || (signed() && resource.data.get('sid', '') == request.auth.uid
            && request.resource.data.get('sid', '') == request.auth.uid && validFlash());
      allow delete: if isAdmin() || (signed() && resource.data.get('sid', '') == request.auth.uid);
    }
    function validFlash() {
      return request.resource.data.keys().hasOnly(['k','n','p','s','a','b','on','t','sid'])
        && request.resource.data.p is number && request.resource.data.p > 0
        && request.resource.data.s is number && request.resource.data.s >= 0
        && request.resource.data.a is number && request.resource.data.b is number;
    }

    // Bukti transfer: dikirim pembeli sebelum status order jadi "menunggu verifikasi"
    match /proofs/{oid} {
      allow read: if signed() && (resource.data.u == request.auth.uid || isAdmin()
        || get(/databases/$(db)/documents/orders/$(oid)).data.get('sid', '') == request.auth.uid);
      allow create: if signed() && request.resource.data.u == request.auth.uid
        && request.resource.data.keys().hasOnly(['u','d','t'])
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000
        && request.resource.data.d[0:11] == 'data:image/'
        && get(/databases/$(db)/documents/orders/$(oid)).data.u == request.auth.uid
        && get(/databases/$(db)/documents/orders/$(oid)).data.st == 'p';
      allow update, delete: if false;
    }

    // Profil website (logo, nama, WhatsApp, deskripsi, media sosial, QRIS): dibaca semua, diubah admin
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'site'
        && request.resource.data.keys().hasOnly(['n','l','w','d','soc','qr'])
        && request.resource.data.get('n', '').size() <= 30
        && request.resource.data.get('l', '').size() <= 400000
        && request.resource.data.get('w', '').size() <= 400
        && request.resource.data.get('d', '').size() <= 300
        && request.resource.data.get('qr', '').size() <= 400000
        && request.resource.data.get('soc', []).size() <= 12;
    }

    // Berita / artikel yang ditulis admin
    match /articles/{id} {
      allow read: if signed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['t','c','i','k','d','on'])
        && request.resource.data.t is string && request.resource.data.t.size() <= 150
        && request.resource.data.c is string && request.resource.data.c.size() <= 20000
        && request.resource.data.get('i', '').size() <= 400000;
    }

    // Game (nama, satuan, ikon, kategori/tab, game baru) yang diatur admin
    match /games/{id} {
      allow read: if signed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['n','cur','ic','ii','f','td','on','nw','t','by'])
        && request.resource.data.get('ii', '').size() <= 400000
        && request.resource.data.get('td', []).size() <= 30;
      // Penjual aktif boleh membuat & mengelola produk/game miliknya sendiri (field "by")
      allow create: if isSeller() && validSellerGame()
        && request.resource.data.get('by', '') == request.auth.uid && request.resource.data.nw == true;
      allow update: if signed() && resource.data.get('by', '') == request.auth.uid
        && request.resource.data.get('by', '') == request.auth.uid && validSellerGame();
      allow delete: if signed() && resource.data.get('by', '') == request.auth.uid;
    }
    function validSellerGame() {
      return request.resource.data.keys().hasOnly(['n','cur','ic','ii','f','td','on','nw','t','by'])
        && request.resource.data.n is string && request.resource.data.n.size() >= 2 && request.resource.data.n.size() <= 40
        && request.resource.data.get('cur', '').size() <= 20
        && request.resource.data.get('ii', '').size() <= 400000
        && request.resource.data.get('td', []).size() <= 30;
    }
    function ownGame(k) {
      return signed() && exists(/databases/$(db)/documents/games/$(k))
        && get(/databases/$(db)/documents/games/$(k)).data.get('by', '') == request.auth.uid;
    }

    // Perubahan produk bawaan website (harga, stok, kategori, urutan, gambar, sembunyikan)
    match /pov/{id} {
      allow read: if signed();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['k','n','p','s','c','o','off','i'])
        && request.resource.data.get('i', '').size() <= 400000;
    }

    // Follow toko: satu dokumen per (toko, pengguna)
    match /follows/{fid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['s','u','t'])
        && request.resource.data.u == request.auth.uid
        && fid == request.resource.data.s + '_' + request.auth.uid
        && request.resource.data.s != request.auth.uid
        && activeSeller(request.resource.data.s);
      allow update: if false;
      allow delete: if signed() && resource.data.u == request.auth.uid;
    }

    // Rating & komentar toko: satu ulasan per pembeli per toko (bisa diubah / dihapus pemiliknya)
    match /reviews/{rid} {
      allow read: if signed();
      allow create: if signed() && validReview(rid);
      allow update: if signed() && resource.data.u == request.auth.uid && validReview(rid)
        && request.resource.data.s == resource.data.s;
      allow delete: if signed() && (resource.data.u == request.auth.uid || isAdmin());
    }
    function validReview(rid) {
      return request.resource.data.keys().hasOnly(['s','u','un','r','c','t'])
        && request.resource.data.u == request.auth.uid
        && rid == request.resource.data.s + '_' + request.auth.uid
        && request.resource.data.s != request.auth.uid
        && activeSeller(request.resource.data.s)
        && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 5
        && request.resource.data.c is string && request.resource.data.c.size() <= 300
        && request.resource.data.un is string && request.resource.data.un.size() <= 30;
    }

    // Leaderboard: satu catatan per order yang SELESAI (id = id order), dicatat saat admin/penjual menyetujui
    match /lb/{oid} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['y','u','un','tt','t'])
        && (isAdmin()
            || (get(/databases/$(db)/documents/orders/$(oid)).data.get('sid', '') == request.auth.uid
                && getAfter(/databases/$(db)/documents/orders/$(oid)).data.st == 'd'
                && request.resource.data.u == getAfter(/databases/$(db)/documents/orders/$(oid)).data.u
                && request.resource.data.tt == getAfter(/databases/$(db)/documents/orders/$(oid)).data.total));
      allow update, delete: if false;
    }

    // Check-in harian: n = hari ke-1..7 berturut-turut, di = indeks hari (WIB), tot = total check-in
    function today() { return math.floor((request.time.toMillis() + 25200000) / 86400000); }
    match /checkins/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n','di','tot'])
        && request.resource.data.n == 1 && request.resource.data.tot == 1
        && request.resource.data.di == today();
      allow update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['n','di','tot'])
        && resource.data.di < today() && request.resource.data.di == today()
        && request.resource.data.tot == resource.data.tot + 1
        && request.resource.data.n == (resource.data.di == today() - 1
              ? (resource.data.n >= 7 ? 7 : resource.data.n + 1) : 1);
      allow delete: if isAdmin();
    }
  }
}
